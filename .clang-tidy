# SPDX-License-Identifier: GPL-3.0-or-later
#
# Static analysis for LINA's own sources. Third-party code is never analysed: its headers are
# system headers, and HeaderFilterRegex only admits headers under src/ and tests/.
# Run with tools/run-clang-tidy.sh.
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  cert-*,
  clang-analyzer-*,
  concurrency-*,
  cppcoreguidelines-*,
  -cppcoreguidelines-avoid-magic-numbers,
  misc-*,
  -misc-include-cleaner,
  modernize-*,
  -modernize-use-trailing-return-type,
  performance-*,
  portability-*,
  readability-*,
  -readability-identifier-length,
  -readability-magic-numbers
WarningsAsErrors: '*'
HeaderFilterRegex: '.*/(src|tests)/.*'
FormatStyle: file
CheckOptions:
  # Catch2's TEST_CASE and REQUIRE expand to code that trips these in every test file.
  cppcoreguidelines-avoid-do-while.IgnoreMacros: true
  readability-function-cognitive-complexity.IgnoreMacros: true
  misc-non-private-member-variables-in-classes.IgnoreClassesWithAllMemberVariablesBeingPublic: true
